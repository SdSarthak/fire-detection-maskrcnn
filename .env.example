# Copy to .env and fill in your own values. Never commit the filled-in file.

# ---------------------------------------------------------------------------
# Training / inference (segmentation/) -- every FireDetectionConfig field can be
# overridden with a FIRE_<FIELD> variable.
# ---------------------------------------------------------------------------
FIRE_TRAIN_EPOCHS=30
FIRE_BATCH_SIZE=2
FIRE_LEARNING_RATE=0.005
FIRE_IMAGE_MIN_DIM=256
FIRE_IMAGE_MAX_DIM=512
FIRE_DETECTION_MIN_CONFIDENCE=0.7
# coco | imagenet | none
FIRE_PRETRAINED_WEIGHTS=coco
# auto | cpu | cuda
FIRE_DEVICE=auto
FIRE_MODEL_PATH=segmentation/weights/fire_detection_model.pt
# Set to 1 ONLY to load a checkpoint that torch.load(weights_only=True) refuses.
# Unpickling an untrusted checkpoint executes arbitrary code.
# FIRE_TRUST_CHECKPOINT=0

# ---------------------------------------------------------------------------
# Flask serving app (mlops/flask_app/)
# ---------------------------------------------------------------------------
MODEL_PATH=/models/fire_detection_model.pt
DEVICE=cpu
SCORE_THRESHOLD=0.5
MASK_THRESHOLD=0.5
MAX_CONTENT_LENGTH_MB=16
MAX_BATCH_SIZE=16
# Cap on DECODED pixels per image. MAX_CONTENT_LENGTH_MB only bounds the
# compressed upload, and a few-kB PNG can decode to gigabytes.
MAX_IMAGE_PIXELS=40000000
# Seconds to wait before retrying a failed model load (0 = retry every request).
MODEL_LOAD_RETRY_SECONDS=30
MODEL_VERSION=1.0.0
# Only needed when the segmentation package is not next to app.py
# SEGMENTATION_ROOT=/app/segmentation

# ---------------------------------------------------------------------------
# Google Cloud deployment
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
ARTIFACT_REPO=fire-detection
GKE_CLUSTER=fire-detection-cluster
GKE_ZONE=us-central1-a
DEPLOYMENT_NAME=fire-detection
CONTAINER_NAME=fire-detection
NAMESPACE=default
PUBSUB_TOPIC=fire-detection-image-ready
MODEL_GCS_URI=gs://your-bucket/fire_detection_model.pt

# Path to a service account key ONLY for local gcloud emulation.
# Prefer Workload Identity in the cluster; never commit a key file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json
